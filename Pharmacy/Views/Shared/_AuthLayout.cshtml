
<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="PharmaCare Account">

    <title>@ViewData["Title"] | PharmaCare</title>

    <link rel="stylesheet" href="~/css/global.css">
    <link rel="stylesheet" href="~/css/auth.css">

    @await RenderSectionAsync("Styles", required: false)

    <script src="~/js/shared/shared.js" defer></script>
</head>

<body class="auth-page">

    <main class="auth-container">

        <!-- Brand -->
        <a asp-controller="Home"
           asp-action="Index"
           class="auth-brand">

            <span class="auth-brand-icon">P</span>
            <span class="auth-brand-name">PharmaCare</span>

        </a>

        <!-- Page Content -->
        @RenderBody()

        <!-- Back To Home -->
        <div class="auth-back-link">

            <a asp-controller="Home" asp-action="Index">
                <span aria-hidden="true">←</span>
                <span>Back to Home</span>
            </a>

        </div>

        <!-- Footer -->
        <footer class="auth-footer">
            <p>© 2026 PharmaCare. All rights reserved.</p>
        </footer>

    </main>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
