@{
    ViewData["Title"] = "Orders";
    ViewData["Subtitle"] = "Manage customer orders";
    ViewData["Page"] = "orders";
    ViewData["ActivePage"] = "Orders";

    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Header -->
<section class="page-header">

    <div class="page-heading">
        <h2>Order Management</h2>
        <p>Review orders and manage their status.</p>
    </div>

</section>

<!-- Statistics -->
<section class="stats-grid" id="ordersStatistics">

    <article class="stat-card">
        <div class="stat-card-top">
            <span class="stat-label">Total Orders</span>
            <span class="stat-icon blue">▣</span>
        </div>

        <h3 class="stat-value" data-order-stat="total">128</h3>
        <p class="stat-description">Demo data</p>
    </article>

    <article class="stat-card">
        <div class="stat-card-top">
            <span class="stat-label">Pending Orders</span>
            <span class="stat-icon orange">◷</span>
        </div>

        <h3 class="stat-value" data-order-stat="pending">18</h3>
        <p class="stat-description">Waiting for review</p>
    </article>

    <article class="stat-card">
        <div class="stat-card-top">
            <span class="stat-label">Processing</span>
            <span class="stat-icon blue">↻</span>
        </div>

        <h3 class="stat-value" data-order-stat="processing">12</h3>
        <p class="stat-description">Being prepared</p>
    </article>

    <article class="stat-card">
        <div class="stat-card-top">
            <span class="stat-label">Delivered</span>
            <span class="stat-icon green">✓</span>
        </div>

        <h3 class="stat-value" data-order-stat="delivered">92</h3>
        <p class="stat-description">Successfully delivered</p>
    </article>

</section>

<!-- Orders Table -->
<section class="dashboard-section">

    <div class="dashboard-section-header">

        <div>
            <h3 class="dashboard-section-title">
                All Orders
            </h3>

            <p>View and manage customer orders</p>
        </div>

        <span class="badge badge-info" id="ordersTotalBadge">
            8 Orders
        </span>

    </div>

    <!-- Toolbar -->
    <div class="table-toolbar">

        <div class="table-search">
            <span>⌕</span>

            <input type="search"
                   id="orderSearch"
                   name="search"
                   placeholder="Search by order ID or customer..."
                   aria-label="Search orders"
                   data-table-search="#ordersTable">
        </div>

        <div class="toolbar-filters">

            <select class="form-control"
                    id="orderStatusFilter"
                    name="statusFilter"
                    aria-label="Filter by status"
                    data-table-filter
                    data-table-target="#ordersTable"
                    data-filter-column="5">

                <option value="">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Ready">Ready</option>
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>

            </select>

            <select class="form-control"
                    id="orderBranchFilter"
                    name="branchFilter"
                    aria-label="Filter by branch"
                    data-table-filter
                    data-table-target="#ordersTable"
                    data-filter-column="3">

                <option value="">All Branches</option>
                <option value="Sheikh Zayed">Sheikh Zayed</option>
                <option value="October">October</option>
                <option value="Dokki">Dokki</option>
                <option value="Maadi">Maadi</option>

            </select>

            <button type="button"
                    class="btn btn-outline btn-sm"
                    data-clear-filters>
                Clear
            </button>

        </div>

    </div>

    <!-- Orders Table -->
    <div class="table-responsive">

        <table class="admin-table" id="ordersTable">

            <thead>
                <tr>
                    <th scope="col">Order ID</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Date</th>
                    <th scope="col">Branch</th>
                    <th scope="col">Total</th>
                    <th scope="col">Status</th>
                    <th scope="col">Payment</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>

